// Tables live in the `app` schema, which Supabase's Data API does not expose.
// The only way in is through this app's server, and every user-facing query
// still runs under Row Level Security (see src/lib/db/rls.ts).
// Search vectors, RLS policies, triggers and storage/realtime policies are in
// the raw SQL migrations 0002_security_and_search and 0003_multi_college.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  schemas  = ["app"]
}

enum Category {
  books
  electronics
  cycles
  hostel
  lab
  clothing
  other

  @@schema("app")
}

enum Condition {
  like_new
  good
  fair
  needs_repair

  @@schema("app")
}

enum PriceType {
  fixed
  free
  exchange

  @@schema("app")
}

enum ListingStatus {
  active
  reserved
  sold

  @@schema("app")
}

enum ReportReason {
  prohibited
  scam
  misleading
  offensive
  spam
  other

  @@schema("app")
}

enum ReportStatus {
  open
  actioned
  dismissed

  @@schema("app")
}

enum CollegeStatus {
  active
  suspended

  @@schema("app")
}

enum DomainStatus {
  active
  pending

  @@schema("app")
}

enum CollegeRole {
  admin
  moderator

  @@schema("app")
}

enum UsageEventType {
  signup
  verified
  listing_created
  listing_sold
  chat_started
  message_sent
  alert_created
  report_filed
  college_created

  @@schema("app")
}

/// One tenant. Every listing, chat, report and alert belongs to exactly one college.
model College {
  id          String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String        @db.VarChar(80)
  shortName   String        @map("short_name") @db.VarChar(12)
  slug        String        @unique @db.VarChar(40)
  logoPath    String?       @map("logo_path") @db.VarChar(200)
  accent      String        @db.VarChar(7)
  pickupSpots String[]      @map("pickup_spots") @db.VarChar(60)
  categories  Category[]
  status      CollegeStatus @default(active)
  isDemo      Boolean       @default(false) @map("is_demo")
  createdBy   String?       @map("created_by") @db.Uuid
  createdAt   DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)

  creator       Profile?                @relation("collegeCreator", fields: [createdBy], references: [id], onDelete: SetNull)
  domains       CollegeDomain[]
  members       Profile[]               @relation("membership")
  roles         CollegeRoleAssignment[]
  listings      Listing[]
  conversations Conversation[]
  reports       Report[]
  alerts        WishlistAlert[]

  @@map("colleges")
  @@schema("app")
}

/// Email domains that make someone a member of a college. Extra domains start pending until a platform admin approves.
model CollegeDomain {
  domain      String       @id @db.VarChar(253)
  collegeId   String       @map("college_id") @db.Uuid
  status      DomainStatus @default(pending)
  requestedBy String?      @map("requested_by") @db.Uuid
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)

  college College @relation(fields: [collegeId], references: [id], onDelete: Cascade)

  @@index([collegeId])
  @@map("college_domains")
  @@schema("app")
}

model CollegeRoleAssignment {
  collegeId String      @map("college_id") @db.Uuid
  userId    String      @map("user_id") @db.Uuid
  role      CollegeRole
  grantedBy String?     @map("granted_by") @db.Uuid
  createdAt DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)

  college College @relation(fields: [collegeId], references: [id], onDelete: Cascade)
  user    Profile @relation("roleHolder", fields: [userId], references: [id], onDelete: Cascade)

  @@id([collegeId, userId])
  @@index([userId])
  @@map("college_roles")
  @@schema("app")
}

/// One row per Supabase Auth user, created by a trigger on auth.users.
model Profile {
  id          String    @id @db.Uuid
  displayName String    @map("display_name") @db.VarChar(40)
  collegeId   String?   @map("college_id") @db.Uuid
  verifiedAt  DateTime? @map("verified_at") @db.Timestamptz(6)
  isAdmin     Boolean   @default(false) @map("is_admin")
  isDemo      Boolean   @default(false) @map("is_demo")
  bannedAt    DateTime? @map("banned_at") @db.Timestamptz(6)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  college           College?                @relation("membership", fields: [collegeId], references: [id], onDelete: SetNull)
  collegesCreated   College[]               @relation("collegeCreator")
  collegeRoles      CollegeRoleAssignment[] @relation("roleHolder")
  listings          Listing[]
  buyerChats        Conversation[]     @relation("buyer")
  sellerChats       Conversation[]     @relation("seller")
  messages          Message[]
  reads             ConversationRead[]
  blocksMade        Block[]            @relation("blocker")
  blocksReceived    Block[]            @relation("blocked")
  reportsFiled      Report[]           @relation("reporter")
  reportsAgainst    Report[]           @relation("reportedUser")
  reportsResolved   Report[]           @relation("resolver")
  alerts            WishlistAlert[]
  pushSubscriptions PushSubscription[]

  @@index([collegeId])
  @@map("profiles")
  @@schema("app")
}

model Listing {
  id            String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sellerId      String        @map("seller_id") @db.Uuid
  collegeId     String        @map("college_id") @db.Uuid
  title         String        @db.VarChar(80)
  description   String        @default("") @db.VarChar(1000)
  category      Category
  condition     Condition
  priceType     PriceType     @map("price_type")
  price         Int?
  originalPrice Int?          @map("original_price")
  exchangeFor   String?       @map("exchange_for") @db.VarChar(80)
  pickupSpot    String        @map("pickup_spot") @db.VarChar(60)
  status        ListingStatus @default(active)
  isHidden      Boolean       @default(false) @map("is_hidden")
  isDemo        Boolean       @default(false) @map("is_demo")
  isbn          String?       @db.VarChar(13)
  bookSemester  Int?          @map("book_semester") @db.SmallInt
  bookSubject   String?       @map("book_subject") @db.VarChar(60)
  bookAuthor    String?       @map("book_author") @db.VarChar(80)
  createdAt     DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  seller        Profile          @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  college       College          @relation(fields: [collegeId], references: [id], onDelete: Cascade)
  photos        ListingPhoto[]
  conversations Conversation[]
  reports       Report[]
  deliveries    AlertDelivery[]

  @@unique([id, collegeId])
  @@index([sellerId, createdAt(sort: Desc)])
  @@map("listings")
  @@schema("app")
}

model ListingPhoto {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  listingId   String   @map("listing_id") @db.Uuid
  storagePath String   @map("storage_path") @db.VarChar(200)
  position    Int      @db.SmallInt
  width       Int      @db.SmallInt
  height      Int      @db.SmallInt
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@unique([listingId, position])
  @@unique([storagePath])
  @@map("listing_photos")
  @@schema("app")
}

model Conversation {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  listingId     String   @map("listing_id") @db.Uuid
  collegeId     String   @map("college_id") @db.Uuid
  buyerId       String   @map("buyer_id") @db.Uuid
  sellerId      String   @map("seller_id") @db.Uuid
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  lastMessageAt DateTime @default(now()) @map("last_message_at") @db.Timestamptz(6)

  listing  Listing            @relation(fields: [listingId, collegeId], references: [id, collegeId], onDelete: Cascade)
  college  College            @relation(fields: [collegeId], references: [id], onDelete: Cascade)
  buyer    Profile            @relation("buyer", fields: [buyerId], references: [id], onDelete: Cascade)
  seller   Profile            @relation("seller", fields: [sellerId], references: [id], onDelete: Cascade)
  messages Message[]
  reads    ConversationRead[]

  @@unique([listingId, buyerId])
  @@index([buyerId, lastMessageAt(sort: Desc)])
  @@index([sellerId, lastMessageAt(sort: Desc)])
  @@index([collegeId])
  @@map("conversations")
  @@schema("app")
}

model Message {
  id             BigInt   @id @default(autoincrement())
  conversationId String   @map("conversation_id") @db.Uuid
  senderId       String   @map("sender_id") @db.Uuid
  body           String   @db.VarChar(2000)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       Profile      @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([conversationId, id])
  @@index([senderId, createdAt])
  @@map("messages")
  @@schema("app")
}

model ConversationRead {
  conversationId String   @map("conversation_id") @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  lastReadAt     DateTime @default(now()) @map("last_read_at") @db.Timestamptz(6)

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         Profile      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([conversationId, userId])
  @@map("conversation_reads")
  @@schema("app")
}

model Block {
  blockerId String   @map("blocker_id") @db.Uuid
  blockedId String   @map("blocked_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  blocker Profile @relation("blocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked Profile @relation("blocked", fields: [blockedId], references: [id], onDelete: Cascade)

  @@id([blockerId, blockedId])
  @@index([blockedId])
  @@map("blocks")
  @@schema("app")
}

model Report {
  id             String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  reporterId     String       @map("reporter_id") @db.Uuid
  collegeId      String       @map("college_id") @db.Uuid
  listingId      String?      @map("listing_id") @db.Uuid
  reportedUserId String?      @map("reported_user_id") @db.Uuid
  reason         ReportReason
  note           String       @default("") @db.VarChar(500)
  status         ReportStatus @default(open)
  resolvedBy     String?      @map("resolved_by") @db.Uuid
  resolvedAt     DateTime?    @map("resolved_at") @db.Timestamptz(6)
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)

  reporter     Profile  @relation("reporter", fields: [reporterId], references: [id], onDelete: Cascade)
  listing      Listing? @relation(fields: [listingId, collegeId], references: [id, collegeId], onDelete: Cascade)
  college      College  @relation(fields: [collegeId], references: [id], onDelete: Cascade)
  reportedUser Profile? @relation("reportedUser", fields: [reportedUserId], references: [id], onDelete: Cascade)
  resolver     Profile? @relation("resolver", fields: [resolvedBy], references: [id], onDelete: SetNull)

  @@index([collegeId, status, createdAt(sort: Desc)])
  @@map("reports")
  @@schema("app")
}

model WishlistAlert {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  collegeId String    @map("college_id") @db.Uuid
  query     String?   @db.VarChar(60)
  category  Category?
  maxPrice  Int?      @map("max_price")
  freeOnly  Boolean   @default(false) @map("free_only")
  active    Boolean   @default(true)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  user       Profile         @relation(fields: [userId], references: [id], onDelete: Cascade)
  college    College         @relation(fields: [collegeId], references: [id], onDelete: Cascade)
  deliveries AlertDelivery[]

  @@index([userId])
  @@index([collegeId, active, category])
  @@map("wishlist_alerts")
  @@schema("app")
}

/// Records which alert already fired for which listing, so nobody is notified twice.
model AlertDelivery {
  alertId   String   @map("alert_id") @db.Uuid
  listingId String   @map("listing_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  alert   WishlistAlert @relation(fields: [alertId], references: [id], onDelete: Cascade)
  listing Listing       @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@id([alertId, listingId])
  @@map("alert_deliveries")
  @@schema("app")
}

model PushSubscription {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  endpoint  String   @unique @db.VarChar(1000)
  p256dh    String   @db.VarChar(200)
  auth      String   @db.VarChar(100)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user Profile @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("push_subscriptions")
  @@schema("app")
}

/// Privacy-respecting usage counter: no IPs, no user agents, no message content.
model UsageEvent {
  id        BigInt         @id @default(autoincrement())
  event     UsageEventType
  userId    String?        @map("user_id") @db.Uuid
  createdAt DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([event, createdAt])
  @@map("usage_events")
  @@schema("app")
}
